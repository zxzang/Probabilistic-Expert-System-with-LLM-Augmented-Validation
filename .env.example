# DeepSeek API configuration for real-LLM experiments.
# Copy this file to `.env` and fill in your key, or set the same variables
# in the shell environment before running the scripts.

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT=60

